<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity"
      maxWidth="-Infinity"
      minHeight="-Infinity"
      minWidth="-Infinity"
      prefHeight="454.0"
      prefWidth="600.0"
      spacing="5.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.eventosynavegacion.controllers.PulperiaController">

   <children>

      <Label text="SISTEMA PULPERIA">
         <font>
            <Font size="30.0"/>
         </font>
      </Label>

      <Label text="Código:"/>
      <TextField fx:id="txtCodigo"
                 promptText="Código del producto"/>

      <Label text="Nombre:"/>
      <TextField fx:id="txtNombre"
                 promptText="Nombre del producto"/>

      <Label text="Precio:"/>
      <TextField fx:id="txtPrecio"
                 promptText="Precio del producto"/>

      <Label text="Cantidad:"/>
      <TextField fx:id="txtCantidad"
                 promptText="Cantidad disponible"/>

      <Button fx:id="btnGuardar"
              mnemonicParsing="false"
              text="Guardar"
              onAction="#guardarProducto"/>

      <Label text="Buscar producto:"/>

      <TextField fx:id="txtBuscar"
                 promptText="Escriba el código y presione ENTER"
                 onKeyPressed="#buscarProducto"/>

      <Button fx:id="btnBuscar"
              mnemonicParsing="false"
              text="Buscar"
              onAction="#buscarProductoBoton"/>

      <Label text="Resultado:"/>

      <Label fx:id="lblResultado"
             wrapText="true"/>

   </children>

   <padding>
      <Insets bottom="10.0"
              left="10.0"
              right="10.0"
              top="10.0"/>
   </padding>

</VBox>