<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="507.0" prefWidth="600.0" spacing="5.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <MenuBar>
        <menus>
          <Menu mnemonicParsing="false" text="Catalogo">
            <items>
              <MenuItem mnemonicParsing="false" text="Nuevo Producto" />
                <MenuItem mnemonicParsing="false" text="Buscar Producto" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ventas">
            <items>
              <MenuItem mnemonicParsing="false" text="Nueva Venta" />
                <MenuItem mnemonicParsing="false" text="Ver Ventas" />
            </items>
          </Menu>
          <Menu mnemonicParsing="false" text="Ayuda">
            <items>
              <MenuItem mnemonicParsing="false" text="Acerca de" />
            </items>
          </Menu>
        </menus>
      </MenuBar>
      <ToolBar prefHeight="40.0" prefWidth="200.0">
        <items>
          <Button fx:id="btnNuevo" mnemonicParsing="false" text="Nuevo" />
            <Button fx:id="btnGuardar" mnemonicParsing="false" text="Guardar" />
            <Button fx:id="btnBuscar" mnemonicParsing="false" text="Buscar" />
        </items>
      </ToolBar>
      <Label fx:id="lblNombre" text="Nombre:" />
      <TextField fx:id="txtNombre" />
      <Label fx:id="lblPrecio" text="Precio:" />
      <TextField fx:id="txtPrecio" />
      <ComboBox fx:id="cbCategoria" prefWidth="150.0" promptText="Categoria" />
      <Button fx:id="btnImagen" mnemonicParsing="false" text="Seleccionar Imagen" />
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
      <TableView fx:id="tvProductos" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="colImagen" prefWidth="75.0" text="Imagen" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Producto" />
            <TableColumn fx:id="colCategoria" prefWidth="75.0" text="Categoria" />
            <TableColumn fx:id="colPrecio" prefWidth="75.0" text="Precio" />
        </columns>
      </TableView>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
